# ---------------------------------------------------------------------------
# Masar AI -- environment configuration
# Copy to .env (repo root) and adjust.  Every value below has a working default
# so that the project runs with no configuration at all.
# ---------------------------------------------------------------------------

# --- Backend --------------------------------------------------------------
# SQLite by default (zero configuration).  For PostgreSQL use e.g.
# postgresql+psycopg://masar:masar@localhost:5432/masar
DATABASE_URL=sqlite:///./masar.db

# Secret used to sign JWTs.  MUST be replaced in any deployed environment.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production-please-use-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Comma-separated list of origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional: enables the live Anthropic-powered mentor.  Without it the mentor
# automatically falls back to the offline retrieval engine and the app still
# works end to end.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Seed the demo accounts and full catalogs on first start (1 = yes).
AUTO_SEED=1

# --- Frontend -------------------------------------------------------------
# Base URL of the FastAPI backend as seen from the browser.
NEXT_PUBLIC_API_URL=http://localhost:8000
